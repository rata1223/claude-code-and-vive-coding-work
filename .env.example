# KIS Open API 자격증명 (한국투자증권 홈페이지에서 발급)
KIS_APP_KEY=여기에_앱키_입력
KIS_APP_SECRET=여기에_시크릿_입력
KIS_ACCOUNT_NO=여기에_계좌번호_입력_12자리
KIS_ENV=paper
KIS_HTS_ID=여기에_HTS_ID_입력

# 텔레그램 알림 (BotFather에서 봇 생성 후 입력)
TELEGRAM_TOKEN=여기에_텔레그램_봇_토큰_입력
TELEGRAM_CHAT_ID=여기에_채팅_ID_입력

# 데이터베이스 (docker-compose 내부 연결 — 변경 불필요)
DB_URL=postgresql://quantdinger:quantdinger@postgres:5432/quantdinger
REDIS_URL=redis://redis:6379

# QuantDinger 웹 대시보드 비밀번호
QUANTDINGER_SECRET_KEY=임의의_긴_문자열_입력

# 리스크 설정 (기본값 권장)
MAX_POSITION_PCT=0.05
DAILY_LOSS_LIMIT_PCT=0.03
MDD_LIMIT_PCT=0.15
STOP_LOSS_PCT=0.07
