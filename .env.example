# ========================================
# KIS (한국투자증권) Open API 자격증명
# ========================================
# KIS 홈페이지 → Open API 신청 후 발급
KIS_APP_KEY=여기에_앱키_입력
KIS_APP_SECRET=여기에_시크릿_입력
KIS_ACCOUNT_NO=여기에_계좌번호_입력_50123456-01형식
KIS_ENV=paper
KIS_HTS_ID=여기에_HTS_ID_입력
# Shadow mode: set true ONLY after 4-week paper run. Default false = signals generated but no orders submitted.
ENABLE_LIVE_TRADING=false

# ========================================
# 키움증권 Open API+ (선택)
# ========================================
KIWOOM_APP_KEY=
KIWOOM_ACCOUNT_NO=

# ========================================
# API 서버 보안 (모두 필수 — 미설정 시 서비스 시작 거부)
# ========================================
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"로 생성
KIS_CREDENTIAL_KEY=여기에_Fernet_키_입력
# python -c "import secrets; print(secrets.token_hex(32))"로 생성
JWT_SECRET_KEY=여기에_긴_랜덤_문자열_입력
JWT_EXPIRE_MINUTES=1440
# python -c "import secrets; print(secrets.token_hex(32))"로 생성
QUANTDINGER_SECRET_KEY=여기에_긴_랜덤_문자열_입력
# CORS 허용 출처 (쉼표 구분). 미설정 시 전체 허용 (로컬 개발용).
# 예시: CORS_ORIGINS=https://app.example.com,capacitor://localhost,http://localhost:5173
CORS_ORIGINS=
# WebSocket CORS. 미설정 시 전체 허용.
WS_CORS_ORIGINS=*

# 운영 API(kis-api, :5001) 인증 키. 미설정 시 인증이 **완전히 비활성화**된다
# (backend/api/server.py: 키가 비어 있으면 가드가 통째로 꺼짐).
# ⚠️ 이 키를 설정하면 kis-api의 모든 호출자에게 인증이 적용된다. api 서비스의
# 비상청산 프록시도 같은 키를 보내므로 두 서비스에 동시에 설정해야 한다.
# python -c "import secrets; print(secrets.token_hex(32))"로 생성
KIS_API_KEY=

# ========================================
# 비상청산(Emergency flatten) — 기본값은 완전 비활성
# ========================================
# 비상청산은 특정 사용자의 포지션이 아니라 **배포 전체의 장부**를 청산한다
# (워커의 프로세스 레벨 브로커 대상). User 모델에 role/admin 컬럼이 없으므로
# 이메일 화이트리스트로 게이트한다. 쉼표 구분, 대소문자 무시.
# 미설정(기본) = **아무도 권한 없음** — fail-closed. 버튼은 있으나 동작하지 않는다.
# ⚠️ 위 KIS_API_KEY가 설정되고 5001 포트가 닫히기 전에는 활성화하지 말 것.
# 예시: EMERGENCY_FLATTEN_ADMINS=admin@example.com,ops@example.com
EMERGENCY_FLATTEN_ADMINS=
# 운영 API 주소. 미설정 시 http://kis-api:5001 (단일 호스트 compose 전용).
# 서비스를 여러 호스트로 분리하면 반드시 https:// 주소로 설정할 것.
KIS_ADMIN_API_BASE=

# ========================================
# 텔레그램 알림
# ========================================
TELEGRAM_TOKEN=여기에_텔레그램_봇_토큰_입력
TELEGRAM_CHAT_ID=여기에_채팅_ID_입력

# ========================================
# 데이터베이스 비밀번호 (반드시 설정)
# ========================================
POSTGRES_PASSWORD=여기에_강력한_비밀번호_입력

# ========================================
# 데이터베이스 (docker-compose 내부 — POSTGRES_PASSWORD 값을 여기도 반영)
# ========================================
DB_URL=postgresql://quantdinger:${POSTGRES_PASSWORD}@postgres:5432/quantdinger
# If REDIS_PASSWORD is set, update REDIS_URL to include auth: redis://:password@redis:6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379
DATABASE_URL=postgresql://quantdinger:${POSTGRES_PASSWORD}@postgres:5432/quantdinger

# ========================================
# 리스크 설정 (기본값 권장)
# ========================================
DAILY_LOSS_LIMIT_PCT=0.03
MDD_LIMIT_PCT=0.15
STOP_LOSS_PCT=0.07
