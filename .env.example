# KIS Open API 자격증명 (한국투자증권 홈페이지에서 발급)
KIS_APP_KEY=여기에_앱키_입력
KIS_APP_SECRET=여기에_시크릿_입력
KIS_ACCOUNT_NO=여기에_계좌번호_입력_12자리
KIS_ENV=paper
KIS_HTS_ID=여기에_HTS_ID_입력

# 텔레그램 알림 (BotFather에서 봇 생성 후 입력)
TELEGRAM_TOKEN=여기에_텔레그램_봇_토큰_입력
TELEGRAM_CHAT_ID=여기에_채팅_ID_입력

# QuantDinger 설정
# SECRET_KEY: python -c "import secrets; print(secrets.token_hex(32))" 로 생성
QUANTDINGER_SECRET_KEY=반드시_랜덤_값으로_변경
QUANTDINGER_ADMIN_USER=admin
QUANTDINGER_ADMIN_PASSWORD=여기에_관리자_비밀번호_입력

# 데이터베이스 (docker-compose 내부 — 변경 불필요)
POSTGRES_PASSWORD=quantdinger123

# 리스크 설정 (기본값 권장)
DAILY_LOSS_LIMIT_PCT=0.03
MDD_LIMIT_PCT=0.15
STOP_LOSS_PCT=0.07
